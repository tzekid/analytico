analytics.example.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	@tracker path /t/*
	handle @tracker {
		reverse_proxy 127.0.0.1:4318 {
			header_up X-Forwarded-For {http.request.remote.host}
			header_up -CF-IPCountry

			transport http {
				dial_timeout 2s
				response_header_timeout 3s
			}
		}
	}

	@events path /e
	handle @events {
		request_body {
			max_size 8KiB
		}
		reverse_proxy 127.0.0.1:4318 {
			header_up X-Forwarded-For {http.request.remote.host}
			header_up -CF-IPCountry
			# Caddy reads the whole body before the request reaches one of the
			# backend's shared workers, so slow uploads wait here (likewise below).
			request_buffers 8KiB

			transport http {
				dial_timeout 2s
				response_header_timeout 3s
			}
		}
	}

	# Session replay chunks (gzip, at most 256 KiB) and heatmap overlay data.
	@replay path /r /h
	handle @replay {
		request_body {
			max_size 256KiB
		}
		reverse_proxy 127.0.0.1:4318 {
			header_up X-Forwarded-For {http.request.remote.host}
			header_up -CF-IPCountry
			request_buffers 256KiB

			transport http {
				dial_timeout 2s
				response_header_timeout 5s
			}
		}
	}

	# Signed server ingestion and probes stay on loopback.
	@private path /i /healthz /readyz
	handle @private {
		respond "not found" 404
	}

	# The workspace, its assets, OAuth and MCP.
	handle {
		request_body {
			max_size 2MiB
		}
		reverse_proxy 127.0.0.1:4318 {
			header_up X-Forwarded-For {http.request.remote.host}
			header_up -CF-IPCountry
			request_buffers 2MiB

			transport http {
				dial_timeout 2s
				response_header_timeout 120s
			}
		}
	}
}
