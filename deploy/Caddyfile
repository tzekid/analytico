# Replace analytics.example with the one canonical Analytico hostname. The
# path allowlist keeps collection public and leaves every dashboard route behind
# Analytico's server-side passkey session.
analytics.example {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	request_body {
		max_size 192KiB
	}
	@analytico_saved_state path /admin/filters/apply /admin/filters/suggest /admin/filters/remove /admin/segments /admin/segments/update /admin/segments/rename /admin/segments/duplicate /admin/segments/delete /admin/saved-views /admin/saved-views/duplicate /admin/saved-views/rename /admin/saved-views/delete /admin/funnels /admin/funnels/edit
	request_body @analytico_saved_state {
		max_size 65536
	}

	@analytico_public path /tracker.aef65945.js /tracker.fb64c486.js /tracker.78135195.js /tracker.d9e94247.js /tracker.81c3b777.js /tracker.6de111c9.js /tracker.bc506cfe.js /tracker.js /v1/event /v2/event /v1/p.gif
	handle @analytico_public {
		reverse_proxy 127.0.0.1:4318 {
			# Overwrite both trust inputs. Restrict direct origin access to
			# Cloudflare before trusting CF-IPCountry in production.
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Analytico-Country {http.request.header.CF-IPCountry}

			transport http {
				dial_timeout 2s
				response_header_timeout 3s
			}
		}
	}

	handle @analytico_saved_state {
		@analytico_saved_state_too_large {
			expression <<CEL
				{http.request.header.Content-Length} != "" &&
				int({http.request.header.Content-Length}) > 65536
				CEL
		}
		respond @analytico_saved_state_too_large 413
		@analytico_saved_state_missing_length header !Content-Length
		respond @analytico_saved_state_missing_length 411

		reverse_proxy 127.0.0.1:4318 {
			header_up X-Forwarded-Proto {scheme}

			transport http {
				dial_timeout 2s
				response_header_timeout 3s
			}
		}
	}

	@analytico_dashboard path /admin /admin/*
	handle @analytico_dashboard {
		reverse_proxy 127.0.0.1:4318 {
			header_up X-Forwarded-Proto {scheme}

			transport http {
				dial_timeout 2s
				response_header_timeout 3s
			}
		}
	}

	@analytico_root path /
	handle @analytico_root {
		redir * /admin 303
	}

	handle {
		respond "not found" 404
	}
}
