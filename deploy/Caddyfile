# Replace analytics.example with the one canonical Analytico hostname. The
# path allowlist keeps collection public and leaves every dashboard route behind
# Analytico's server-side passkey session.
analytics.example {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	request_body {
		max_size 192KB
	}

	@analytico_public path /tracker.aef65945.js /tracker.js /v1/event /v1/p.gif
	handle @analytico_public {
		reverse_proxy 127.0.0.1:4318 {
			# Overwrite both trust inputs. Restrict direct origin access to
			# Cloudflare before trusting CF-IPCountry in production.
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Analytico-Country {http.request.header.CF-IPCountry}

			transport http {
				dial_timeout 2s
				response_header_timeout 3s
			}
		}
	}

	@analytico_dashboard path /admin /admin/*
	handle @analytico_dashboard {
		reverse_proxy 127.0.0.1:4318 {
			header_up X-Forwarded-Proto {scheme}

			transport http {
				dial_timeout 2s
				response_header_timeout 3s
			}
		}
	}

	@analytico_root path /
	handle @analytico_root {
		redir * /admin 303
	}

	handle {
		respond "not found" 404
	}
}
