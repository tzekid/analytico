# Replace analytics-admin.example. This private vhost is deliberately separate
# from the public collector hostname. Analytico's passkey session is the only
# owner gate; do not add a second application state model at the proxy.
analytics-admin.example {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	request_body {
		max_size 192KB
	}

	@analytico_dashboard path /admin /admin/*
	handle @analytico_dashboard {
		reverse_proxy 127.0.0.1:4318 {
			header_up X-Forwarded-Proto {scheme}

			transport http {
				dial_timeout 2s
				response_header_timeout 3s
			}
		}
	}

	handle {
		respond "not found" 404
	}
}
