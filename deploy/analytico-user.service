[Unit]
Description=Analytico embedded web analytics
Documentation=https://github.com/tzekid/analytico
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/analytico
ExecStartPre=%h/.local/opt/analytico/current/bin/analytico doctor %h/.local/share/analytico
ExecStart=%h/.local/opt/analytico/current/bin/analytico serve --listen 127.0.0.1:4318 --meta %h/.local/share/analytico/meta.db --events %h/.local/share/analytico/events.duckdb --temp %h/.local/share/analytico/tmp --visitor-key-file %h/.local/share/analytico/visitor.key
Restart=on-failure
RestartSec=2s
TimeoutStopSec=3s
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryHigh=192M
MemoryMax=256M
TasksMax=64
LimitNOFILE=1024
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=default.target
