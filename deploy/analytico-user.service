[Unit]
Description=Analytico CLI-first analytics collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/opt/analytico/current/bin/analytico serve --data %h/.local/share/analytico --listen 127.0.0.1:4318
Restart=on-failure
RestartSec=2s
TimeoutStopSec=3s
UMask=0077

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryHigh=128M
MemoryMax=192M
TasksMax=32
LimitNOFILE=1024
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=default.target
