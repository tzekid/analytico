@@ -269,0 +279,32 @@ fn parsePositiveU32(value: []const u8) ?u32 {
+fn isValidAnalyticoUrl(value: []const u8) bool {
+    if (value.len == 0 or value.len > 2048) return false;
+    for (value) |byte| {
+        if (byte <= 0x20 or byte == 0x7f) return false;
+    }
+    if (std.mem.indexOfScalar(u8, value, '#') != null) return false;
+
+    const secure = std.mem.startsWith(u8, value, "https://");
+    const plain = std.mem.startsWith(u8, value, "http://");
+    if (!secure and !plain) return false;
+    const scheme_len: usize = if (secure) "https://".len else "http://".len;
+    const rest = value[scheme_len..];
+    const authority_end = std.mem.indexOfAny(u8, rest, "/?") orelse rest.len;
+    const authority = rest[0..authority_end];
+    if (authority.len == 0 or std.mem.indexOfScalar(u8, authority, '@') != null) return false;
+
+    const colon = std.mem.indexOfScalar(u8, authority, ':');
+    const host = if (colon) |index| authority[0..index] else authority;
+    if (colon) |index| {
+        const port = authority[index + 1 ..];
+        const parsed = std.fmt.parseInt(u16, port, 10) catch return false;
+        if (parsed == 0) return false;
+    }
+    if (plain and
+        !std.ascii.eqlIgnoreCase(host, "localhost") and
+        !std.mem.eql(u8, host, "127.0.0.1"))
+    {
+        return false;
+    }
+    return host.len > 0;
+}
