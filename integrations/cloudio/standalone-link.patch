+    );
+
+    cfg.analytico_url = null;
+    try applyConfigText(arena.allocator(), &cfg,
+        \\[integrations]
+        \\analytico_url = "javascript:alert(1)"
+    );
+    try std.testing.expect(cfg.analytico_url == null);
+
+    try applyConfigText(arena.allocator(), &cfg,
+        \\[integrations]
+        \\analytico_url = "http://analytics.example.com/admin"
+    );
+    try std.testing.expect(cfg.analytico_url == null);
+
+    try applyConfigText(arena.allocator(), &cfg,
+        \\[integrations]
+        \\analytico_url = "http://127.0.0.1:4319/admin"
+    );
+    try std.testing.expectEqualStrings(
