@@ -360,0 +402,36 @@ test "config parser reads platform and passkey settings" {
+test "config parser accepts only secure or loopback Analytico links" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    var cfg = Config{ .domains = try parseList(arena.allocator(), "plosca.ru") };
+    try applyConfigText(arena.allocator(), &cfg,
